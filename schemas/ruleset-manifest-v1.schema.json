{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd-world.local/schemas/ruleset-manifest-v1.schema.json",
  "type": "object",
  "required": ["schemaVersion", "active", "rulesets", "sourceSets"],
  "properties": {
    "schemaVersion": {"const": "dnd-world-ruleset-manifest/1"},
    "active": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "rulesets": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/ref"}, {"type": "object", "required": ["title", "status", "capabilities", "contentSourceSet", "completeness"]}]},
    "sourceSets": {"type": "array", "items": {"type": "object", "required": ["id", "provenanceStatus", "licenseStatus", "allowedCompletenessClaim"]}}
  },
  "$defs": {"ref": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "profile": {"type": "string", "minLength": 1}}}}
}
